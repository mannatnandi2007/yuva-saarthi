# YUVAA Saarthi — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is already in .gitignore.
#
# Usage:
#   cp .env.example .env
#   # Fill in values below, then:
#   uvicorn app.main:app --reload --port 8000

# ---------------------------------------------------------------------------
# Supabase — Required for any real DB or auth operation
# ---------------------------------------------------------------------------
# Find these in your Supabase project dashboard:
#   Settings → API → Project URL and anon/service_role keys
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ---------------------------------------------------------------------------
# LLM — Required for Mannat's LangChain pipeline (Phase 3)
# ---------------------------------------------------------------------------
# Leave blank until the real LLM integration is connected.
# The mock stub in app/services/llm_service.py works without this.
LLM_API_KEY=

# ---------------------------------------------------------------------------
# Telephony — Required for Phase 3 escalation (Khushal)
# ---------------------------------------------------------------------------
BLAND_AI_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# Dev-only settings — NEVER set to true in production or staging
# ---------------------------------------------------------------------------
# When DEV_BYPASS_AUTH=true, the GET/POST endpoints accept an X-Dev-User-Id
# header instead of a real Supabase JWT. Used for local testing without OTP.
# Must be false or absent in any deployed environment.
DEV_BYPASS_AUTH=false
