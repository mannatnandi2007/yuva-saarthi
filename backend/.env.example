# YUVAA Saarthi Environment Configuration Template
# Duplicate this file as '.env' and fill in correct values.

# Supabase Configurations
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# LLM Orchestration
LLM_API_KEY=your-gemini-or-claude-api-key

# Telephony and Notifications
BLAND_AI_KEY=your-bland-ai-pathway-api-key
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
